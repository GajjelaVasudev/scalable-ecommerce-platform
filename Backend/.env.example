# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (MongoDB Atlas or local replica set for transactions)
MONGODB_URI=mongodb://localhost:27017/ecommerce?replicaSet=rs0

# Redis Configuration (Cache, Rate Limiting)
REDIS_URL=redis://localhost:6379

# Authentication (JWT Secret - minimum 32 characters recommended)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_32_chars

# Razorpay Payment Gateway (Test Mode Credentials)
RAZORPAY_KEY_ID=rzp_test_replaceWithYourKeyId
RAZORPAY_KEY_SECRET=replaceWithYourKeySecret
RAZORPAY_WEBHOOK_SECRET=replaceWithYourWebhookSecret
